   "id": "c1",
   "type": "cue",
   "text": "Kinda lonesome back here.",
   "index": 1,
   "start": 180.43,
   "end": 182.85
  },
  {
   "id": "c2",
   "type": "cue",
   "text": "Yeah, little help.",
   "index": 2,
   "start": 183.308,
   "end": 184.348
  },
  {
   "id": "c3",
   "type": "cue",
   "text": "Okay, just, I have to keep my hands on the wheel.",
   "index": 3,
   "start": 185.686,
   "end": 190.146
  },
  {
   "id": "c4",
   "type": "cue",
   "text": "Excuse me.",
   "index": 4,
   "start": 191.859,
   "end": 192.979
  },
  {
   "id": "c5",
   "type": "cue",
   "text": "Dopinder.",
   "index": 5,
   "start": 194.653,
   "end": 195.953
  },
  {
   "id": "c6",
   "type": "cue",
   "text": "Nice.",
   "index": 6,
   "start": 199.658,
   "end": 200.618
  },
  {
   "id": "c7",
   "type": "cue",
   "text": "Smells good, no?",
   "index": 7,
   "start": 201.785,
   "end": 202.905
  },
  {
   "id": "c8",
   "type": "cue",
   "text": "She would have made me a very agreeable wife.",
   "index": 8,
   "start": 208.876,
   "end": 212.496
  },
  {
   "id": "c9",
   "type": "cue",
   "text": "But, Gita's heart has been stolen by my cousin Bandhu.",
   "index": 9,
   "start": 213.38,
   "end": 216.84
  },
  {
   "id": "c10",
   "type": "cue",
   "text": "He is as dishonorable as he is attractive.",
   "index": 10,
   "start": 216.884,
   "end": 220.854
  },
  {
   "id": "c11",
   "type": "cue",
   "text": "Dopinder, I'm starting to think there's a reason I'm in this cab today.",
   "index": 11,
   "start": 222.014,
   "end": 225.854
  },
  {
   "id": "c12",
   "type": "cue",
   "text": "Yeah, sir, you called for it, remember?",
   "index": 12,
   "start": 226.185,
   "end": 227.645
  },
  {
   "id": "c13",
   "type": "cue",
   "text": "When you find it, the whole world tastes like Daffodil Daydream.",
   "index": 13,
   "start": 232.566,
   "end": 235.356
  },
  {
   "id": "c14",
   "type": "cue",
   "text": "So you gotta hold onto love... tight!",
   "index": 14,
   "start": 236.57,
   "end": 240.157
  },
  {
   "id": "c15",
   "type": "cue",
   "text": "Or else the whole world tastes like Mama June after hot yoga.",
   "index": 15,
   "start": 244.494,
   "end": 248.004
  },
  {
   "id": "c16",
   "type": "cue",
   "text": "Sir, what does Miss Mama June taste like?",
   "index": 16,
   "start": 248.54,
   "end": 250.88
  },
  {
   "id": "c17",
   "type": "cue",
   "text": "It's bad.",
   "index": 17,
   "start": 256.882,
   "end": 258.592
  },
  {
   "id": "c18",
   "type": "cue",
   "text": "Why the fancy red suit, Mr. Pool?",
   "index": 18,
   "start": 259.176,
   "end": 261.846
  },
  {
   "id": "c19",
   "type": "cue",
   "text": "That's because it's Christmas Day, Dopinder.",
   "index": 19,
   "start": 261.887,
   "end": 263.847
  }
